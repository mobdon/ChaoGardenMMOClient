{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Sonic Advance ASOE span catalog (not a cross-game contract)",
  "type": "array",
  "minItems": 1,
  "maxItems": 65536,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "domain", "addressSpace", "offset", "length", "sha256", "status", "evidence", "codec", "decodedLength", "decodedSha256"],
    "properties": {
      "id": {"type": "string", "pattern": "^sonic-advance\\.asoe\\.r0\\.[a-z0-9._-]+$"},
      "domain": {"type": "string", "minLength": 1},
      "addressSpace": {"enum": ["rom", "garden-decoded"]},
      "offset": {"type": "integer", "minimum": 0, "maximum": 8388607},
      "length": {"type": "integer", "minimum": 1, "maximum": 8388608},
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "status": {"enum": ["decoded", "opaque"]},
      "evidence": {"type": "string", "minLength": 1},
      "codec": {"enum": ["raw", "lz77", "rle"]},
      "decodedLength": {"type": ["integer", "null"], "minimum": 1, "maximum": 33554432},
      "decodedSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
    },
    "allOf": [{
      "if": {"properties": {"codec": {"const": "raw"}}},
      "then": {"properties": {"decodedLength": {"type": "null"}, "decodedSha256": {"type": "null"}}},
      "else": {"properties": {"decodedLength": {"type": "integer"}, "decodedSha256": {"type": "string"}}}
    }]
  }
}
